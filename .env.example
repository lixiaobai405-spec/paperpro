# Copy to .env on the server and chmod 600 .env. Never send real keys in a ZIP.
PAPERPRO_PORT=8766
PAPERPRO_IMAGE_TAG=local

# Strict mode: conversion failure is an error, not a different PDF layout.
# Other supported values: auto, reportlab; word is Windows-only.
PAPERPRO_PDF_ENGINE=libreoffice
PAPERPRO_RESUME_FONT=Noto Sans CJK SC

# Optional: leave empty to let users supply their own key through the web UI.
PAPERPRO_DEEPSEEK_API_KEY=

# Optional custom OpenAI-compatible provider (leave empty if unused).
PAPERPRO_OPENAI_API_KEY=
PAPERPRO_OPENAI_BASE_URL=
PAPERPRO_OPENAI_MODEL=
