  "narrative_codes": {
    "experience": {
      "timeline_review": "时间线只依据已校对的起止年月进行计算；建议核查未明确标注的任职和空档，避免在面试中产生歧义。",
      "responsibility_proof": "任职时间与职责证据分开核实；建议准备实际承担任务、交付物及工作边界的说明。"
    },
    "potential": {
      "growth_evidence": "潜力评级只代表简历证据覆盖程度；建议补充可核实的学习经历、技能更新和职责变化，不据此推测个人能力。",
      "credential_review": "学历与证书属于可核查的事实，请以已取得的材料为准，不将尚未取得的资格写成既有成果。"
    },
    "motivation": {
      "jd_alignment": "针对岗位时，请选取与真实职责匹配的项目证据，不添加未经证实的企业要求或求职动机。",
      "company_context": "如已提供真实岗位描述，可按其要求组织原有经历；仅有公司名称不足以推断官方筛选标准。"
    }
  },
